// Firestoreのセキュリティルール（控え）
// 実際のルールはFirebaseの画面（Firestore → ルール）に貼り付けて公開します。
// 持ち主のメールアドレスは公開しないよう、ここでは OWNER_EMAIL と書いています。
// 貼り付けるときは OWNER_EMAIL を持ち主のGmailアドレスに置き換えてください。

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && myEmail() == 'OWNER_EMAIL';
    }
    function isStaff() {
      return isOwner() || (
        signedIn()
        && exists(/databases/$(database)/documents/staff/$(myEmail()))
        && get(/databases/$(database)/documents/staff/$(myEmail())).data.active == true
      );
    }
    // 大会運営の名簿の人（opsStaff）：大会運営（opsTournaments）だけ読み書きできる
    function isOpsStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/opsStaff/$(myEmail()))
        && get(/databases/$(database)/documents/opsStaff/$(myEmail())).data.active == true;
    }
    match /opsTournaments/{id} {
      allow read, write: if isStaff() || isOpsStaff();
    }
    match /opsStaff/{email} {
      // 自分が名簿に載っているかだけは、本人も確認できる（追加・削除はスタッフだけ）
      allow read: if isStaff() || (signedIn() && email == myEmail());
      allow write: if isStaff();
    }
    // 動静表：保護者・生徒がログインなしで記入する
    //   動静表（doseiTerms）は、IDを知っていれば読める（記入ページに名前・日付を出すため）
    //   記入（doseiEntries）は、IDを知っていれば読める・直せる（IDは推測できない長い文字＝修正用URL）
    //   全部の一覧・削除・先生の記入欄（doseiNotes）は、スタッフだけ（下の決まり）
    match /doseiTerms/{id} {
      allow get: if true;
    }
    match /doseiEntries/{id} {
      function okEntry() {
        let d = request.resource.data;
        return id.size() >= 16
          && d.keys().hasOnly(['termId', 'memberId', 'name', 'writer', 'parentName', 'contacts', 'days', 'trip', 'health', 'createdAt', 'updatedAt'])
          && d.termId is string && d.memberId is string
          && d.name is string && d.name.size() <= 60
          && d.writer in ['本人', '保護者']
          && d.parentName is string && d.parentName.size() <= 60
          && d.contacts is list && d.contacts.size() <= 2
          && d.days is map && d.days.size() <= 70
          && d.trip is string && d.trip.size() <= 500
          && d.health is string && d.health.size() <= 500
          && exists(/databases/$(database)/documents/doseiTerms/$(d.termId))
          && get(/databases/$(database)/documents/doseiTerms/$(d.termId)).data.open == true;
      }
      allow get: if true;
      allow create: if okEntry();
      allow update: if okEntry() && request.resource.data.termId == resource.data.termId;
    }
    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
