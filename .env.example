# このファイルは「見本」です。実際の値はここに書かず、Vercelの環境変数に設定します。
#
# 設定する名前：NEXT_PUBLIC_FIREBASE_CONFIG
# 設定する値　：Firebaseの「プロジェクトの設定 → マイアプリ」に表示される
#               const firebaseConfig = { ... }; の部分を丸ごと貼り付け

NEXT_PUBLIC_FIREBASE_CONFIG='const firebaseConfig = { apiKey: "xxxx", authDomain: "bukatu-xxxx.firebaseapp.com", projectId: "bukatu-xxxx", storageBucket: "bukatu-xxxx.firebasestorage.app", messagingSenderId: "0000", appId: "1:0000:web:xxxx" };'
